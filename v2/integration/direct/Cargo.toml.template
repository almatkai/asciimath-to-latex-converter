[package]
name = "asciimath-direct-adapter-contracts"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false
[[test]]
name = "concrete-adapter"
path = "../../tests/concrete_adapter.rs"
[dependencies]
tezbar-asciimath-to-latex-converter = { path = "../.." }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"
tokio = { version = "=1.48.0", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.20.0"
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.28"
tauri = { path = "../harness/runtime/tauri-stub" }
