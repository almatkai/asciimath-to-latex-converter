[package]
name = "beta-session-runtime"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false
[lib]
test = false
doctest = false
[dependencies]
tezbar-asciimath-to-latex-converter = { path = "../../.." }
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"
tokio = { version = "=1.48.0", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.20.0"
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.28"
tauri = { path = "tauri-stub" }

base64 = "=0.22.1"
sha2 = "=0.10.9"
